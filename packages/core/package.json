{
  "name": "vite-plugin-entry-shaking",
  "version": "0.5.2",
  "description": "Mimic tree-shaking behaviour when importing code from an entry file in development mode.",
  "keywords": [
    "entry",
    "tree shaking",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://github.com/Dschungelabenteuer/vite-plugin-entry-shaking/tree/main/#readme",
  "bugs": {
    "url": "https://github.com/Dschungelabenteuer/vite-plugin-entry-shaking/issues"
  },
  "license": "MIT",
  "author": "Charles Gruenais",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dschungelabenteuer/vite-plugin-entry-shaking",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "main": "dist/index.cjs",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts"
  },
  "scripts": {
    "dev": "pnpm unbuild --stub",
    "build": "pnpm unbuild",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "es-module-lexer": "catalog:",
    "magic-string": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "esbuild": "catalog:",
    "fast-glob": "catalog:",
    "globals": "catalog:",
    "ts-dedent": "catalog:",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vite-plugin-entry-shaking-debugger": "workspace:*",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "vite": ">=5.1.0"
  },
  "optionalDependencies": {
    "esbuild": "catalog:",
    "fast-glob": "catalog:",
    "vite-plugin-entry-shaking-debugger": "workspace:*"
  },
  "engines": {
    "node": "^14.18.0 || >=16.0.0"
  }
}
