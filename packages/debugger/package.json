    "directory": "packages/debugger"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "scripts": {
    "dev": "vite src/client",
    "build": "obuild && vite build src/client",
    "typecheck": "vue-tsc --noEmit",
    "stub": "obuild --stub",
    "storybook:dev": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "cypress:open": "cypress open"
  },
